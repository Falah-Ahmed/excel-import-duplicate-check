FRAPPE_BASE_URL=https://your-frappe-site.com
FRAPPE_API_KEY=your_api_key
FRAPPE_API_SECRET=your_api_secret

# Parent DocType (exact Name from DocType List — one line only)
FRAPPE_REGISTER_DOCTYPE=Registered People

# Parent fieldnames from Customize Form (Name), NOT Excel labels
# Excel "Name"            → FRAPPE_NAME_FIELD
# Excel "Passport No."    → FRAPPE_PASSPORT_FIELD
# Excel "Phone Number"    → FRAPPE_PHONE_FIELD
# Excel "ID Number"       → FRAPPE_ID_FIELD
FRAPPE_NAME_FIELD=full_name
FRAPPE_NAME_AR_FIELD=full_name_ar
FRAPPE_PASSPORT_FIELD=passport_number
FRAPPE_PHONE_FIELD=phone_number
FRAPPE_ID_FIELD=id_number

# Family Member child table
FRAPPE_INCLUDE_FAMILY_MEMBERS=1
FRAPPE_FAMILY_DOCTYPE=Family Member
FRAPPE_FAMILY_NAME_FIELD=family_name
# If child table uses different fieldnames, set these:
# FRAPPE_FAMILY_PASSPORT_FIELD=passport_number
# FRAPPE_FAMILY_PHONE_FIELD=phone_number
# FRAPPE_FAMILY_ID_FIELD=id_number
